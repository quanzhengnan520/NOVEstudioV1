# =============================================================================
# NOVE Studio — example environment (copy to `.env` / Docker Compose overrides)
# =============================================================================
#
# Core
# -----
# NODE_ENV=development
# PORT=4000
#
# Database (Postgres)
# --------------------
# Local default matches docker-compose.yml service `postgres`.
# DATABASE_URL=postgresql://nove:nove@localhost:5432/nove
#
# Redis (BullMQ + optional cache)
# --------------------------------
# REDIS_URL=redis://127.0.0.1:6379
#
# Auth / JWT / cookies
# ---------------------
# JWT_ACCESS_SECRET=change-me-access
# JWT_REFRESH_SECRET=change-me-refresh
# ACCESS_TOKEN_TTL_SEC=900
# REFRESH_TOKEN_TTL_SEC=1209600
# COOKIE_SECURE=false
#
# CORS / public URLs
# ------------------
# FRONTEND_ORIGIN=http://localhost:3000
# FRONTEND_URL=
# BACKEND_INTERNAL_URL=http://127.0.0.1:4000   # used by Next.js rewrites in dev
#
# Credits & signup
# ----------------
# INITIAL_SIGNUP_CREDITS=40
# BOOTSTRAP_ADMIN_EMAIL=you@company.com
#
# Providers (AI)
# --------------
# NOVE_PROVIDERS_ENABLE_NETWORK=0
# NOVE_WORKER_CONCURRENCY=2
# Provider API keys are not pre-configured in this example.
# See backend/src/config/env.ts for all supported variables.
#
# Object storage (R2)
# -------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
#
# SMTP / verification
# --------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# RECAPTCHA_SECRET_KEY=
#
# Frontend-only (Next)
# ---------------------
# NEXT_PUBLIC_WS_PORT=4000
# NEXT_PUBLIC_WS_URL=
