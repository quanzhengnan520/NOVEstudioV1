# Default: root `docker-compose.yml` (postgres on localhost:5432, DB `nove`).
# Dev infra (`infra/docker-compose.dev.yml`): host port 15432, DB `nove_dev`, user/password `nove`.
DATABASE_URL=postgresql://nove:nove@127.0.0.1:15432/nove_dev
REDIS_URL=redis://127.0.0.1:16379
PORT=4000
NODE_ENV=development

# Auth / cookies
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=1209600
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000
# Optional extra allowed origins (comma-separated), e.g. production public URL
FRONTEND_URL=

# AI providers (API keys / tokens — not pre-configured; set per-deploy)
# See backend/src/config/env.ts for all supported environment variables.
NOVE_WORKER_CONCURRENCY=2
# Outbound HTTP to AI vendors disabled by default. Set to 1 to enable.
NOVE_PROVIDERS_ENABLE_NETWORK=0
NOVE_DEFAULT_CHAT_MODEL=gpt-4o-mini
NOVE_DEFAULT_IMAGE_MODEL=dall-e-3

# Credits
INITIAL_SIGNUP_CREDITS=40

# First registered email matching this value becomes admin (optional) and skips email verification.
# Playwright E2E (`npm run test:e2e`) uses e2e-bootstrap@test.nove — set the same here when running tests against an already-started backend.
BOOTSTRAP_ADMIN_EMAIL=

# Anti-spam / email verification
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
REGISTER_MAX_PER_IP_24H=5
EMAIL_VERIFICATION_TTL_HOURS=48
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DEV_LOG_EMAILS=true

# Debug-only: POST /v1/credits/consume (off in production unless set to 1)
# NOVE_ENABLE_CREDITS_CONSUME_API=0
