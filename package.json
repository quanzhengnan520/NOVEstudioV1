{
  "name": "nove-monorepo",
  "private": true,
  "description": "NOVE Studio full-stack monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n fe,be \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "migrate": "npm run migrate -w backend",
    "migrate:up": "npm run migrate:up -w backend",
    "migrate:down": "npm run migrate:down -w backend",
    "migrate:create": "npm run migrate:create -w backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
